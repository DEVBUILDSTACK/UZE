flowchart TD
    START([Your profile is declared])

    subgraph ASSESS["Choose your assessment path"]
        CHOICE{"How do you want<br/>to prove your skill?"}
        PA["<b>Path A · Hands-on keyboard</b><br/>Live coding demonstration<br/>You write code, we watch"]
        PB["<b>Path B · Vibe walkthrough</b><br/>You bring code you built<br/>You explain your decisions"]
    end

    START --> CHOICE
    CHOICE -->|"I prefer live"| PA
    CHOICE -->|"I have work to show"| PB

    subgraph LADDER["Your code climbs the ladder"]
        L1["<b>VIBE</b><br/>Code from AI, ideation,<br/>or assembly — not yet fully yours"]
        L2["<b>HARD_REVISION</b><br/>You rewrite it line by line<br/>Every line is yours"]
        L3["<b>DRAFT</b><br/>Structurally complete<br/>Tests + docs exist"]
        L4["<b>FINAL</b><br/>Reviewed and signed off<br/>Ready to deploy"]
        L5["<b>SANDBOX</b><br/>Live on your own Vercel URL<br/>Isolated, not public"]
        L6["<b>PRODUCTION</b><br/>Shipped, or your own artifact<br/>Living and iterable"]
        L1 --> L2 --> L3 --> L4 --> L5 --> L6
    end

    PA --> LADDER
    PB --> LADDER

    subgraph SPIN["Sandbox spin-up — your own UI"]
        S1["<b>HUMAN UI</b><br/>A web app for people to use"]
        S2["<b>AUTONOMOUS UI</b><br/>An API for agents to call"]
        S3["<b>BOTH</b><br/>One deploy, two surfaces"]
    end

    L5 --> SPIN

    style START fill:#c8e6c9,stroke:#2e7d32
    style CHOICE fill:#fff3cd,stroke:#b8860b
    style PA fill:#e3f2fd,stroke:#1565c0
    style PB fill:#e3f2fd,stroke:#1565c0
    style L1 fill:#ffcdd2,stroke:#b02a37
    style L2 fill:#ffe0b2,stroke:#e65100
    style L3 fill:#fff9c4,stroke:#b8860b
    style L4 fill:#c8e6c9,stroke:#2e7d32
    style L5 fill:#b3e5fc,stroke:#0277bd
    style L6 fill:#1e7d32,color:#fff,stroke:#14532d
    style S1 fill:#f3e5f5,stroke:#7b1fa2
    style S2 fill:#f3e5f5,stroke:#7b1fa2
    style S3 fill:#f3e5f5,stroke:#7b1fa2

