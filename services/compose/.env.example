# Composition layer (database: uzemarkets-compose) — example environment.
# Copy to .env and fill in locally. Never commit a real .env. No secrets
# are required by the schema itself; this is only a connection string.
#
# Shape: postgresql+psycopg://<user>@<host>:<port>/uzemarkets-compose
COMPOSE_DATABASE_URL=postgresql+psycopg://compose@127.0.0.1:5432/uzemarkets-compose
