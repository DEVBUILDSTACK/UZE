{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceTask",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "tripProfileId": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/TaskState"
    },
    "details": {
      "type": "object"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tripProfileId",
    "kind",
    "state",
    "details"
  ],
  "$defs": {
    "TaskState": {
      "title": "TaskState",
      "type": "string",
      "enum": [
        "REQUESTED",
        "QUOTED",
        "DEPOSIT_PENDING",
        "CONFIRMED",
        "FAILED",
        "CANCELLED"
      ]
    }
  }
}
