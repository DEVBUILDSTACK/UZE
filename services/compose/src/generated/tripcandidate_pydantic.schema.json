          "$ref": "#/$defs/RailPayload1"
        },
        {
          "$ref": "#/$defs/RailPayload2"
        },
        {
          "$ref": "#/$defs/RailPayload3"
        },
        {
          "$ref": "#/$defs/RailPayload4"
        },
        {
          "$ref": "#/$defs/RailPayload5"
