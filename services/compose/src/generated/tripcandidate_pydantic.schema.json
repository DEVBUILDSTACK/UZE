{
  "$defs": {
    "CommitmentClass": {
      "enum": [
        "IRREVERSIBLE_ON_CHAIN",
        "CANCELLABLE_UNTIL_WINDOW",
        "CHANGEABLE_WITH_FEE",
        "APPOINTMENT",
        "MEDICAL_PACKAGE"
      ],
      "title": "CommitmentClass",
      "type": "string"
    },
    "DivergenceCode": {
      "enum": [
        "SNAPSHOT_EXPIRED",
        "SOURCE_NOT_FOUND",
        "LISTING_GONE",
        "TICKET_TRANSFERRED",
        "TICKET_REDEEMED",
        "SEAT_TAKEN",
        "PRICE_MOVED",
        "UPSTREAM_UNAVAILABLE"
      ],
      "title": "DivergenceCode",
      "type": "string"
    },
    "OfferSnapshot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "tripCandidateId": {
          "title": "Tripcandidateid",
          "type": "string"
        },
        "rail": {
          "$ref": "#/$defs/Rail"
        },
        "sourceRef": {
          "title": "Sourceref",
          "type": "string"
        },
        "commitmentClass": {
          "$ref": "#/$defs/CommitmentClass"
        },
        "price": {
          "$ref": "#/$defs/Price"
        },
        "terms": {
          "additionalProperties": true,
          "title": "Terms",
          "type": "object"
        },
        "payload": {
          "$ref": "#/$defs/RailPayload"
        },
        "divergenceCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DivergenceCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
