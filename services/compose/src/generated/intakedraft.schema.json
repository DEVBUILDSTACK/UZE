{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntakeDraft",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "answers": {
      "type": "object"
    },
    "missingSlots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidSlots": {
      "type": "object"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "token",
    "answers",
    "missingSlots",
    "invalidSlots",
    "expiresAt"
  ],
  "$defs": {}
}
