{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuestionManifest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "questions": {
      "$ref": "#/$defs/QuestionSlotList"
    },
    "active": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key",
    "version",
    "title",
    "questions"
  ],
  "$defs": {
    "QuestionSlotList": {
      "title": "QuestionSlotList",
      "type": "array",
      "items": {
        "title": "QuestionSlot",
        "oneOf": [
          {
            "title": "EnumQuestionSlot",
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "type": {
                "const": "ENUM"
              },
              "required": {
                "type": "boolean"
              },
              "deferrable": {
                "type": "boolean"
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "title": "QuestionSlotDependency",
                  "type": "object",
                  "properties": {
                    "slot": {
                      "type": "string"
                    },
                    "op": {
                      "type": "string"
                    },
                    "value": {}
                  },
                  "required": [
                    "slot",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "moduleGate": {
                "title": "ModuleType",
                "type": "string",
                "enum": [
                  "TICKETS",
                  "STAY",
                  "FLIGHT",
                  "PARKING",
                  "TRANSIT",
                  "DINING",
                  "TRANSFER",
                  "VIP_CONCIERGE",
                  "FACILITY"
                ]
              },
              "validation": {
                "type": "object"
              },
              "promptHuman": {
                "type": "string"
              },
              "promptAgent": {
                "type": "string"
              },
              "enumValues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "key",
              "type",
              "enumValues",
              "required",
              "deferrable",
              "promptHuman",
              "promptAgent"
            ],
            "additionalProperties": false
          },
          {
            "title": "StandardQuestionSlot",
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "type": {
                "title": "QuestionSlotType",
                "type": "string",
                "enum": [
                  "STRING",
                  "INT",
                  "DATE",
                  "BOOL",
                  "OBJECT",
                  "ARRAY"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "deferrable": {
                "type": "boolean"
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "title": "QuestionSlotDependency",
                  "type": "object",
                  "properties": {
                    "slot": {
                      "type": "string"
                    },
                    "op": {
                      "type": "string"
                    },
                    "value": {}
                  },
                  "required": [
                    "slot",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "moduleGate": {
                "title": "ModuleType",
                "type": "string",
                "enum": [
                  "TICKETS",
                  "STAY",
                  "FLIGHT",
                  "PARKING",
                  "TRANSIT",
                  "DINING",
                  "TRANSFER",
                  "VIP_CONCIERGE",
                  "FACILITY"
                ]
              },
              "validation": {
                "type": "object"
              },
              "promptHuman": {
                "type": "string"
              },
              "promptAgent": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "type",
              "required",
              "deferrable",
              "promptHuman",
              "promptAgent"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
