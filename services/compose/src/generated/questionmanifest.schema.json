{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuestionManifest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "questions": {
      "type": "object"
    },
    "active": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key",
    "version",
    "title",
    "questions"
  ],
  "$defs": {}
}
