{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfferSnapshot",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "tripCandidateId": {
      "type": "string"
    },
    "rail": {
      "$ref": "#/$defs/Rail"
    },
    "sourceRef": {
      "type": "string"
    },
    "commitmentClass": {
      "$ref": "#/$defs/CommitmentClass"
    },
    "price": {
      "$ref": "#/$defs/Price"
    },
    "terms": {
      "type": "object"
    },
    "payload": {
      "$ref": "#/$defs/OfferPayload"
    },
    "divergenceCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/DivergenceCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "divergenceAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "retentionUntil": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "tripCandidateId",
    "rail",
    "sourceRef",
    "commitmentClass",
    "price",
    "terms",
    "payload",
    "expiresAt"
  ],
  "$defs": {
    "Rail": {
      "title": "Rail",
      "type": "string",
      "enum": [
        "SOLANA_NFT",
        "HOTEL_AGGREGATOR",
        "FLIGHT_SEARCH",
        "FACILITY",
        "PARKING",
        "TRANSFER",
        "DINING_TASK"
      ]
    },
    "CommitmentClass": {
      "title": "CommitmentClass",
      "type": "string",
      "enum": [
        "IRREVERSIBLE_ON_CHAIN",
        "CANCELLABLE_UNTIL_WINDOW",
        "CHANGEABLE_WITH_FEE",
        "APPOINTMENT",
        "MEDICAL_PACKAGE"
      ]
    },
    "Price": {
      "title": "Price",
      "type": "object",
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": [
            "USDC"
          ]
        },
        "taxesIncluded": {
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "currency",
        "taxesIncluded"
      ],
      "additionalProperties": false
    },
    "OfferPayload": {
      "title": "OfferPayload",
      "discriminator": {
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "title": "TicketOfferDetail",
          "type": "object",
          "properties": {
            "kind": {
              "const": "ticket"
            },
            "seat": {
              "type": "string"
            },
            "tier": {
              "type": "string"
            },
            "gate": {
              "type": "string"
            },
            "mintRef": {
              "type": "string"
            },
            "ticketRef": {
              "type": "string"
            },
            "listingRef": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "seat",
            "tier"
          ],
          "additionalProperties": false
        },
        {
          "title": "StayOfferDetail",
          "type": "object",
          "properties": {
            "kind": {
              "const": "stay"
            },
            "phaseKind": {
              "type": "string"
            },
            "nights": {
              "type": "integer"
            },
            "propertyRef": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "phaseKind",
            "nights"
          ],
          "additionalProperties": false
        },
        {
          "title": "FlightOfferDetail",
          "type": "object",
          "properties": {
            "kind": {
              "const": "flight"
            },
            "itineraryRef": {
              "type": "string"
            },
            "carrier": {
              "type": "string"
            },
            "departAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "itineraryRef"
          ],
          "additionalProperties": false
        },
        {
          "title": "FacilityOfferDetail",
          "type": "object",
          "properties": {
            "kind": {
              "const": "facility"
            },
            "facilityRef": {
              "type": "string"
            },
            "packageRef": {
              "type": "string"
            },
            "procedureClassBand": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "facilityRef",
            "packageRef"
          ],
          "additionalProperties": false
        },
        {
          "title": "ParkingOfferDetail",
          "type": "object",
          "properties": {
            "kind": {
              "const": "parking"
            },
            "anchorRef": {
              "type": "string"
            },
            "spotRef": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "anchorRef"
          ],
          "additionalProperties": false
        },
        {
          "title": "TransferOfferDetail",
          "type": "object",
          "properties": {
            "kind": {
              "const": "transfer"
            },
            "taskRef": {
              "type": "string"
            },
            "pickupAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "taskRef"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DivergenceCode": {
      "title": "DivergenceCode",
      "type": "string",
      "enum": [
        "SNAPSHOT_EXPIRED",
        "SOURCE_NOT_FOUND",
        "LISTING_GONE",
        "TICKET_TRANSFERRED",
        "TICKET_REDEEMED",
        "SEAT_TAKEN",
        "PRICE_MOVED",
        "UPSTREAM_UNAVAILABLE"
      ]
    }
  }
}
