{
  "$defs": {
    "CommitmentClass": {
      "enum": [
        "IRREVERSIBLE_ON_CHAIN",
        "CANCELLABLE_UNTIL_WINDOW",
        "CHANGEABLE_WITH_FEE",
        "APPOINTMENT",
        "MEDICAL_PACKAGE"
      ],
      "title": "CommitmentClass",
      "type": "string"
    },
    "Currency": {
      "enum": [
        "USDC"
      ],
      "title": "Currency",
      "type": "string"
    },
    "DivergenceCode": {
      "enum": [
        "SNAPSHOT_EXPIRED",
        "SOURCE_NOT_FOUND",
        "LISTING_GONE",
        "TICKET_TRANSFERRED",
        "TICKET_REDEEMED",
        "SEAT_TAKEN",
        "PRICE_MOVED",
        "UPSTREAM_UNAVAILABLE"
      ],
      "title": "DivergenceCode",
      "type": "string"
    },
    "FacilityOfferDetail": {
      "additionalProperties": false,
