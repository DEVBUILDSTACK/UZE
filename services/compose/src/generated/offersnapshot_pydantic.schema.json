    "OfferPayload": {
      "discriminator": {
        "mapping": {
          "facility": "#/$defs/FacilityOfferDetail",
          "flight": "#/$defs/FlightOfferDetail",
          "parking": "#/$defs/ParkingOfferDetail",
          "stay": "#/$defs/StayOfferDetail",
          "ticket": "#/$defs/TicketOfferDetail",
          "transfer": "#/$defs/TransferOfferDetail"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TicketOfferDetail"
        },
        {
          "$ref": "#/$defs/StayOfferDetail"
        },
        {
          "$ref": "#/$defs/FlightOfferDetail"
        },
        {
          "$ref": "#/$defs/FacilityOfferDetail"
        },
        {
          "$ref": "#/$defs/ParkingOfferDetail"
        },
        {
          "$ref": "#/$defs/TransferOfferDetail"
        }
      ],
      "title": "OfferPayload"
    },
    "ParkingOfferDetail": {
      "additionalProperties": false,
