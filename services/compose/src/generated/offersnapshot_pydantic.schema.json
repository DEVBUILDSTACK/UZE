        "kind": {
          "const": "facility",
          "title": "Kind",
          "type": "string"
        },
        "facilityRef": {
          "title": "Facilityref",
          "type": "string"
        },
        "packageRef": {
          "title": "Packageref",
          "type": "string"
        },
        "procedureClassBand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Procedureclassband"
        }
      },
      "required": [
        "kind",
        "facilityRef",
        "packageRef"
      ],
      "title": "FacilityOfferDetail",
      "type": "object"
    },
    "FlightOfferDetail": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "flight",
          "title": "Kind",
          "type": "string"
        },
        "itineraryRef": {
          "title": "Itineraryref",
          "type": "string"
        },
        "carrier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Carrier"
        },
        "departAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
