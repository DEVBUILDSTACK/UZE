    },
    "tripCandidateId": {
      "title": "Tripcandidateid",
      "type": "string"
    },
    "rail": {
      "$ref": "#/$defs/Rail"
    },
    "sourceRef": {
      "title": "Sourceref",
      "type": "string"
    },
    "commitmentClass": {
      "$ref": "#/$defs/CommitmentClass"
    },
    "price": {
      "$ref": "#/$defs/Price"
    },
    "terms": {
      "additionalProperties": true,
      "title": "Terms",
      "type": "object"
    },
    "payload": {
      "$ref": "#/$defs/OfferPayload"
    },
    "divergenceCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/DivergenceCode"
