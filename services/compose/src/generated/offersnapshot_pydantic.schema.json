        "ticketRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ticketref"
        },
        "listingRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
