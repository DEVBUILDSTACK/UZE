// UZE Prisma schema — Neon Postgres. Prisma is the migration authority
// for the Python API. (Next.js apps use Drizzle against their own tables;
// never let two ORMs migrate the same tables.)
//
// Conventions follow the Assurative-V2 backend approach:
// - UUID primary keys (Postgres-native gen_random_uuid, cf. SQLModelTable)
// - createdAt/updatedAt on every table
// - email_address identity field (team convention)
generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL") // pooled (Neon -pooler)
  directUrl         = env("DIRECT_URL")   // direct (Neon, for migrations)
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email_address String   @unique
  name         String?
  passwordHash String?  // operator accounts only; end users auth via email OTP
  role         String   @default("user") // user | operator | agent | admin (spec §6.1)
  // SocialFi profile (20-second onboarding) — one profile per user
  handle       String?  @unique
  bio          String?
  avatarUrl    String?
  interests    String[]
  referralCode String?  @unique // minted at profile creation (UZE-XXXXXX)
  referredBy   String?  // referrer's referralCode (QR scan / link attribution)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tickets      Ticket[]
  listings     Listing[] @relation("SellerListings")
  bids         Bid[]     @relation("BidderBids")
}

model Event {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  venue     String?
  city      String?
  startsAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([startsAt])
}

model Ticket {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id])
  ownerId   String?  @db.Uuid
  owner     User?    @relation(fields: [ownerId], references: [id])
  tier      String   @default("general")
  status    String   @default("active") // active | listed | transferred | redeemed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listings  Listing[]

  @@index([eventId])
  @@index([ownerId])
}

// UZED.si secondary market — private resale listings.
model Listing {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId    String   @db.Uuid
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  sellerId    String   @db.Uuid
  seller      User     @relation("SellerListings", fields: [sellerId], references: [id])
  priceCents  Int
  feeCents    Int      @default(0) // seller fee shown separately (brand spec)
  status      String   @default("active") // active | sold | cancelled | flagged
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ticketId])
  @@index([sellerId])
  @@index([status])
}

// RAG — GIRA agentic guidance retrieval. Requires the pgvector extension:
//   CREATE EXTENSION IF NOT EXISTS vector;
// (Neon supports pgvector; prestart.sh ensures it.)
model DocumentChunk {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source    String   // e.g. "knowledge-base", "event:<id>", "listing:<id>"
  content   String   @db.Text
  embedding Unsupported("vector(1536)")?
  createdAt DateTime @default(now())

  @@index([source])
}
// Sealed-bid auctions (Arcium-style; bids hidden until close).
model Auction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  eventId   String?  @db.Uuid
  event     Event?   @relation(fields: [eventId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("scheduled") // scheduled | open | closed | settled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bids      Bid[]

  @@index([status])
  @@index([endsAt])
}

model Bid {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auctionId String   @db.Uuid
  auction   Auction  @relation(fields: [auctionId], references: [id])
  bidderId  String   @db.Uuid
  bidder    User     @relation("BidderBids", fields: [bidderId], references: [id])
  amountCents Int
  // Sealed: amount hidden until auction closes; commitment hash optional.
  createdAt DateTime @default(now())

  @@index([auctionId])
}
