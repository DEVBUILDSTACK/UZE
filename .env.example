# UZE environment — canonical names. Copy to .env and fill in.
# One name per concept (see ANALYSIS.md §6 anti-patterns — no variants).

# --- Database (Neon Postgres) ---
# Pooled connection string for the API runtime:
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/uze?sslmode=require
# Direct connection string for Prisma migrations (prestart.sh):
DIRECT_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/uze?sslmode=require

# --- Redis (scale: cache, queues, rate limits) ---
REDIS_URL=redis://localhost:6379/0

# --- RAG embeddings (GIRA guidance retrieval; key in Secret Manager, never baked) ---
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- API ---
APP_NAME=uze-api
DEBUG=false
PORT=8000
SECRET_KEY=change-me-in-prod
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Web (build-time, non-secret only) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- GCP deploy (CI secrets, never in this file) ---
# GCP_PROJECT_ID, GCP_REGION, ARTIFACT_REGISTRY_REPO=uza-images
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID (frontend deploys)
